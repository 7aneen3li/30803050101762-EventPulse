        {
          "name": "Get All Events - Pagination",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events?page=1&limit=10",
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Events endpoint returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "const events = json.events || (json.data && json.data.events) || json.data || [];",
                  "",
                  "pm.test('Pagination metadata exists', function () {",
                  "    const raw = JSON.stringify(json);",
                  "    pm.expect(raw).to.include('total');",
                  "    pm.expect(raw).to.include('page');",
                  "    pm.expect(raw).to.include('limit');",
                  "    pm.expect(raw).to.include('totalPages');",
                  "});",
                  "",
                  "if (Array.isArray(events) && events.length > 0) {",
                  "    pm.collectionVariables.set('eventId', events[0]._id);",
                  "    if (events[0].category && events[0].category._id) {",
                  "        pm.collectionVariables.set('categoryId', events[0].category._id);",
                  "    }",
                  "}"
                ]
