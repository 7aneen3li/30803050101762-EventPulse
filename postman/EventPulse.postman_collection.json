              "raw": "{{healthUrl}}",
              "host": [
                "{{healthUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health endpoint returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Health status is success/ok', function () {",
                  "    pm.expect(['success', 'ok']).to.include(json.status);",
                  "});",
                  "",
                  "pm.test('Database status is connected', function () {",
                  "    pm.expect(JSON.stringify(json).toLowerCase()).to.include('connected');",
