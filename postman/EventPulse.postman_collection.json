              "raw": "{\n  \"title\": \"EventPulse Capacity Test {{random}}\",\n  \"description\": \"Testing capacity management for the final rubric.\",\n  \"category\": \"{{categoryId}}\",\n  \"date\": \"2026-12-15T10:00:00.000Z\",\n  \"city\": \"Cairo\",\n  \"venue\": \"EventPulse Test Venue\",\n  \"capacity\": 1\n}"
