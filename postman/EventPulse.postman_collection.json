            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{attendee1Token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/registrations/my"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('My registrations returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel Someone Else Registration - Must Fail",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{attendee2Token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/registrations/{{registration1Id}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Attendee cannot cancel another users registration', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel Own Registration",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{attendee1Token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/registrations/{{registration1Id}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('User can cancel own registration', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
